# Kopie nach ".env" anlegen und mit echten Werten befüllen.
# Diese Datei selbst enthält keine Secrets und darf committet werden.

# API-Key für Google Places API (New). Muss in der Google Cloud Console
# für "Places API (New)" freigeschaltet sein.
GOOGLE_MAPS_API_KEY=

# Pfad zur Service-Account-JSON-Datei für Google Sheets (siehe README, Setup-Schritt 2).
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# ID des Google Sheets, in das die Leads geschrieben werden.
# Zu finden in der Sheet-URL zwischen /d/ und /edit.
SHEET_ID=
