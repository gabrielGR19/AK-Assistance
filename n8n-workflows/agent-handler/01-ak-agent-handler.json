    {
      "id": "kunden_config_pruefen",
      "name": "Kunden-Config pruefen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        200
      ],
      "parameters": {
        "jsCode": "// SCHRITT 3 - Kunden-Config auswerten. Es gibt bewusst KEINEN Default-Kunden:\n// ohne passende, aktive Zeile wird die Anfrage abgelehnt. Das ist der Kern\n// der Mandantentrennung - ab hier traegt jeder Folgeschritt genau diese Config.\nconst anfrage = $('Auth und Validierung').first().json;\nconst roh = $input.all().map(i => i.json).filter(z => z && z.kunde_id);\n\nfunction jsonFeld(wert, standard) {\n  if (wert === null || wert === undefined || wert === '') return standard;\n  if (typeof wert === 'object') return wert;\n  try { return JSON.parse(String(wert)); } catch (e) { return standard; }\n}\n\nif (roh.length === 0) {\n  return [{ json: Object.assign({}, anfrage, { fehler_code: 'unknown_kunde', message: 'unknown kunde_id' }) }];\n}\n\nconst z = roh[0];\n// aktiv kann als Boolean oder als Text aus der DataTable kommen.\nconst aktiv = z.aktiv === true || String(z.aktiv).toLowerCase() === 'true';\nif (!aktiv) {\n  return [{ json: Object.assign({}, anfrage, { fehler_code: 'kunde_inaktiv', message: 'kunde inaktiv' }) }];\n}\n\nconst config = {\n  kunde_id: String(z.kunde_id),\n  kunde_name: String(z.kunde_name || z.kunde_id),\n  zeitzone: String(z.zeitzone || 'Europe/Berlin'),\n  // Kalender\n  kalender_typ: String(z.kalender_typ || 'calcom'),\n  cal_api_base: String(z.cal_api_base || 'https://api.cal.com/v2').replace(/\\/+$/, ''),\n  cal_event_type_id: String(z.cal_event_type_id || ''),\n  cal_username: String(z.cal_username || ''),\n  // Telefonie\n  sms_from: String(z.sms_from || ''),\n  twilio_account_sid: String(z.twilio_account_sid || ''),\n  // CRM\n  crm_typ: String(z.crm_typ || 'none'),\n  crm_quelle: String(z.crm_quelle || ''),\n  crm_blatt: String(z.crm_blatt || 'Tabelle1'),\n  // Bereitschaft\n  dispatch_kanal: String(z.dispatch_kanal || ''),\n  dispatch_ziel: String(z.dispatch_ziel || ''),\n  // Freiform\n  system_endpoints: jsonFeld(z.system_endpoints, {}),\n  sms_vorlagen: jsonFeld(z.sms_vorlagen, {}),\n};\n\n// Sicherheitsnetz: die geladene Config muss zur angefragten kunde_id gehoeren.\nif (config.kunde_id !== anfrage.kunde_id) {\n  return [{ json: Object.assign({}, anfrage, { fehler_code: 'config_mismatch', message: 'config mismatch' }) }];\n}\n\nreturn [{ json: Object.assign({}, anfrage, { config: config }) }];"
      }
    },
