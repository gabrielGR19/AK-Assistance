    {
      "id": "unbekannte_action",
      "name": "Unbekannte Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        780
      ],
      "parameters": {
        "jsCode": "// Fallback des Routers: action existiert nicht. Bewusst keine Liste der\n// gueltigen Actions in der Antwort - der Agent soll nicht raten koennen.\nconst e = $input.first().json;\nreturn [{ json: Object.assign({}, e, { fehler_code: 'unknown_action', message: 'unknown action' }) }];"
      }
    },
    {
      "id": "antwort_bauen",
      "name": "Antwort bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        300
      ],
      "parameters": {
        "jsCode": "// SCHRITT 5 - Einheitliche Antwort. Alle Pfade (Auth-Fehler, unbekannter\n// Kunde, unbekannte Action, Sub-Workflow-Ergebnis, Sub-Workflow-Absturz)\n// muenden hier und ergeben immer { success, data, message }.\nconst anfrage = $('Auth und Validierung').first().json;\nconst item = $input.first().json || {};\n\nlet success = false;\nlet data = {};\nlet message = 'unerwartete antwort';\nlet http_code = 200;\n\nif (item.fehler_code) {\n  message = String(item.message || item.fehler_code);\n  http_code = Number(item.http_code || 200);\n} else if (item.error) {\n  // Sub-Workflow ist gelaufen, hat aber eine Exception geworfen\n  // (onError = continueRegularOutput). Details bleiben im Log, nicht in der Antwort.\n  message = 'interner fehler';\n} else if (typeof item.success === 'boolean') {\n  success = item.success;\n  data = (item.data && typeof item.data === 'object') ? item.data : {};\n  message = String(item.message || '');\n}\n\nreturn [{ json: {\n  success: success,\n  data: data,\n  message: message,\n  http_code: http_code,\n  // Felder ab hier nur fuers Logging, sie sind nicht Teil der Antwort an Retell.\n  request_id: anfrage.request_id,\n  kunde_id: anfrage.kunde_id,\n  agent_typ: anfrage.agent_typ,\n  action: anfrage.action,\n  call_id: anfrage.call_id,\n  dauer_ms: Date.now() - Number(anfrage.start_ms || Date.now()),\n} }];"
      }
    },
    {
      "id": "antwort_senden",
      "name": "Antwort senden",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1820,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: $json.success, data: $json.data, message: $json.message }) }}",
        "options": {
          "responseCode": "={{ $json.http_code }}"
        }
      }
    },
