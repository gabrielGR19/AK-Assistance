    {
      "id": "auth_und_validierung",
      "name": "Auth und Validierung",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        300
      ],
      "parameters": {
        "jsCode": "// SCHRITT 1+2 - Authentifizierung und Eingabevalidierung.\n// Dieser Node wirft nie eine Exception: ein Abbruchgrund wird als\n// fehler_code weitergereicht, damit Retell immer eine valide Antwort bekommt.\nconst eingang = $input.first().json;\nconst headers = eingang.headers || {};\nconst body = eingang.body || {};\n\n// Das Secret liegt serverseitig in der Umgebungsvariablen AK_WEBHOOK_SECRET\n// und steht bewusst nirgends im Workflow.\nconst erwartet = String($env.AK_WEBHOOK_SECRET || '');\n// n8n liefert Header-Namen kleingeschrieben; die zweite Variante ist nur Absicherung.\nconst gesendet = String(headers['x-ak-auth'] || headers['X-AK-Auth'] || '');\n\n// Vergleich in konstanter Zeit, damit die Antwortzeit nichts ueber das Secret verraet.\nfunction gleich(a, b) {\n  if (a.length !== b.length) return false;\n  let diff = 0;\n  for (let i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);\n  return diff === 0;\n}\n\nconst basis = {\n  request_id: String(Date.now()) + '-' + Math.random().toString(36).slice(2, 8),\n  start_ms: Date.now(),\n  kunde_id: String(body.kunde_id == null ? '' : body.kunde_id).trim(),\n  agent_typ: String(body.agent_typ == null ? '' : body.agent_typ).trim(),\n  action: String(body.action == null ? '' : body.action).trim(),\n  params: (body.params && typeof body.params === 'object' && !Array.isArray(body.params)) ? body.params : {},\n  // Retell schickt die call_id je nach Konfiguration auf zwei Wegen mit.\n  call_id: String(body.call_id || (body.call && body.call.call_id) || ''),\n  fehler_code: '',\n  http_code: 200,\n  message: '',\n};\n\nif (!erwartet) {\n  // Kein Secret gesetzt = Fehlkonfiguration. Dann wird grundsaetzlich nichts durchgelassen.\n  return [{ json: Object.assign({}, basis, { fehler_code: 'unauthorized', http_code: 401, message: 'unauthorized' }) }];\n}\nif (!gesendet || !gleich(gesendet, erwartet)) {\n  return [{ json: Object.assign({}, basis, { fehler_code: 'unauthorized', http_code: 401, message: 'unauthorized' }) }];\n}\nif (!basis.kunde_id || !basis.agent_typ || !basis.action) {\n  return [{ json: Object.assign({}, basis, { fehler_code: 'invalid_request', message: 'invalid request' }) }];\n}\nreturn [{ json: basis }];"
      }
    },
