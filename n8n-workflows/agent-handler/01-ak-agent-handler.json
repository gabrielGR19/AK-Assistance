    {
      "id": "retell_anfrage",
      "name": "Retell Anfrage",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -260,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
