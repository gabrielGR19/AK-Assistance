{
  "name": "ak-sub-notify_dispatch",
  "nodes": [
    {
      "id": "aufruf_vom_handler",
      "name": "Aufruf vom Handler",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "eingaben_pruefen",
      "name": "Eingaben pruefen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Alarmiert den Bereitschaftskontakt dieses Kunden. Kanal und Ziel stehen in\n// der Config - der Agent kann das Ziel nicht ueberschreiben.\nconst e = $input.first().json;\nconst p = e.params || {};\nconst c = e.config || {};\n\nconst kanal = String(c.dispatch_kanal || '').toLowerCase();\nconst ziel = String(c.dispatch_ziel || '');\n\n// Der Agent liefert nur Sachinformationen, den Text baut dieser Workflow.\n// Bewusst ohne Vorlage aus der Config: ein Notruf darf nicht daran scheitern,\n// dass jemand vergessen hat, eine Vorlage anzulegen.\nconst meldung = [\n  'NOTFALL ueber Telefonagent',\n  'Betrieb: ' + String(c.kunde_name || c.kunde_id),\n  'Anrufer: ' + String(p.name || 'unbekannt'),\n  'Rueckruf: ' + String(p.telefon || e.from_number || 'unbekannt'),\n  'Ort: ' + String(p.ort || 'unbekannt'),\n  'Anliegen: ' + String(p.anliegen || p.beschreibung || 'keine Angabe'),\n].join('\\n').slice(0, 900);\n\nlet fehler = '';\nif (!kanal || !ziel) fehler = 'keine bereitschaft konfiguriert';\nelse if (['sms', 'telegram', 'email'].indexOf(kanal) === -1) fehler = 'kanal unbekannt';\nelse if (kanal === 'sms' && !c.twilio_account_sid) fehler = 'twilio nicht konfiguriert';\nelse if (kanal === 'sms' && !c.sms_from) fehler = 'keine absendernummer konfiguriert';\n\nreturn [{ json: Object.assign({}, e, {\n  kanal: kanal, ziel: ziel, meldung: meldung, fehler: fehler,\n}) }];"
      }
    },
    {
      "id": "kanal",
      "name": "Kanal",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "k0",
                    "leftValue": "={{ $json.fehler }}",
                    "rightValue": "",
                    "operator": {
                      "type": "string",
                      "operation": "notEmpty",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "abbruch"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "k_sms",
                    "leftValue": "={{ $json.kanal }}",
                    "rightValue": "sms",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "sms"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "k_telegram",
                    "leftValue": "={{ $json.kanal }}",
                    "rightValue": "telegram",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "telegram"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "k_email",
                    "leftValue": "={{ $json.kanal }}",
                    "rightValue": "email",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "email"
            }
          ]
        },
        "looseTypeValidation": true,
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "unbekannt"
        }
      }
    },
    {
      "id": "alarm_sms_senden",
      "name": "Alarm-SMS senden",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        140
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.twilio.com/2010-04-01/Accounts/{{ $json.config.twilio_account_sid }}/Messages.json",
        "options": {
          "timeout": 8000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "From",
              "value": "={{ $json.config.sms_from }}"
            },
            {
              "name": "To",
              "value": "={{ $json.ziel }}"
            },
            {
              "name": "Body",
              "value": "={{ $json.meldung }}"
            }
          ]
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "credentials": {
        "httpBasicAuth": {
          "id": "AK_TWILIO_CREDENTIAL_ID",
          "name": "Twilio API"
        }
      }
    },
    {
      "id": "telegram_senden",
      "name": "Telegram senden",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "chatId": "={{ $json.ziel }}",
        "text": "={{ $json.meldung }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "9Vp8wPx7MROw0sAO",
          "name": "Telegram account"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 500
    },
    {
      "id": "e_mail_senden",
      "name": "E-Mail senden",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        700,
        460
      ],
      "parameters": {
        "sendTo": "={{ $json.ziel }}",
        "subject": "=NOTFALL - {{ $json.config.kunde_name }} (Telefonagent)",
        "emailType": "text",
        "message": "={{ $json.meldung }}",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "rXdENEAJjoE47EcL",
          "name": "Gmail account Agent"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 500
    },
    {
      "id": "antwort_bauen",
      "name": "Antwort bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "jsCode": "const ktx = $('Eingaben pruefen').first().json;\n// Vereinheitlicht die Antwort. Kein Sub-Workflow gibt je etwas anderes\n// zurueck als { success, data, message } - darauf bauen die Retell-Agenten\n// ihre Erfolgs- und Fehlerzweige auf.\nfunction antwort(success, data, message) {\n  return { success: !!success, data: data || {}, message: String(message || '') };\n}\n\nif (ktx.fehler) return [{ json: antwort(false, { alarmiert: false }, ktx.fehler) }];\n\nconst r = $input.first().json || {};\nif (r.error) {\n  return [{ json: antwort(false, { alarmiert: false, kanal: ktx.kanal },\n    'bereitschaft nicht erreichbar') }];\n}\n// Der SMS-Weg laeuft ueber HTTP und liefert einen Statuscode.\nif (r.statusCode !== undefined) {\n  if (Number(r.statusCode) >= 400) {\n    return [{ json: antwort(false, { alarmiert: false, kanal: ktx.kanal,\n      code: Number(r.statusCode) }, 'alarm konnte nicht zugestellt werden') }];\n  }\n}\nreturn [{ json: antwort(true, { alarmiert: true, kanal: ktx.kanal }, 'bereitschaft alarmiert') }];"
      }
    },
    {
      "id": "notiz_2026",
      "name": "Notiz 2026",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        220,
        640
      ],
      "parameters": {
        "content": "## ak-sub-notify_dispatch\nKanal (`sms` | `telegram` | `email`) und Ziel kommen aus der Kunden-Config.\nDer Alarmtext wird hier gebaut und haengt an **keiner** Kundenvorlage.\nEinziger Ort mit Retry auf einem Sendevorgang: eine doppelte Alarm-SMS ist besser als keine.",
        "width": 460,
        "height": 220,
        "color": 4
      }
    }
  ],
  "connections": {
    "Aufruf vom Handler": {
      "main": [
        [
          {
            "node": "Eingaben pruefen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Eingaben pruefen": {
