{
  "name": "ak-sub-notify_dispatch",
  "nodes": [
    {
      "id": "aufruf_vom_handler",
      "name": "Aufruf vom Handler",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "eingaben_pruefen",
      "name": "Eingaben pruefen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Alarmiert den Bereitschaftskontakt dieses Kunden. Kanal und Ziel stehen in\n// der Config - der Agent kann das Ziel nicht ueberschreiben.\nconst e = $input.first().json;\nconst p = e.params || {};\nconst c = e.config || {};\n\nconst kanal = String(c.dispatch_kanal || '').toLowerCase();\nconst ziel = String(c.dispatch_ziel || '');\n\n// Der Agent liefert nur Sachinformationen, keinen fertigen Text.\nconst meldung = [\n  'NOTFALL ueber Telefonagent',\n  'Betrieb: ' + String(c.kunde_name || c.kunde_id),\n  'Anrufer: ' + String(p.name || 'unbekannt'),\n  'Rueckruf: ' + String(p.telefon || 'unbekannt'),\n  'Ort: ' + String(p.ort || 'unbekannt'),\n  'Anliegen: ' + String(p.anliegen || p.beschreibung || 'keine Angabe'),\n].join('\\n').slice(0, 900);\n\nlet fehler = '';\nif (!kanal || !ziel) fehler = 'keine bereitschaft konfiguriert';\nelse if (['sms', 'telegram', 'email'].indexOf(kanal) === -1) fehler = 'kanal unbekannt';\n\nreturn [{ json: Object.assign({}, e, {\n  kanal: kanal, ziel: ziel, meldung: meldung, fehler: fehler,\n  // Fuer den SMS-Weg wird der bestehende Sub-Workflow wiederverwendet.\n  params: Object.assign({}, p, {\n    telefon: ziel, textvorlage: 'notfall', werte: {\n      betrieb: String(c.kunde_name || ''), anrufer: String(p.name || ''),\n      telefon: String(p.telefon || ''), anliegen: String(p.anliegen || ''),\n    },\n  }),\n}) }];"
      }
    },
    {
      "id": "kanal",
      "name": "Kanal",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "k0",
                    "leftValue": "={{ $json.fehler }}",
                    "rightValue": "",
                    "operator": {
                      "type": "string",
                      "operation": "notEmpty",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "abbruch"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "k_sms",
                    "leftValue": "={{ $json.kanal }}",
                    "rightValue": "sms",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "sms"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "k_telegram",
                    "leftValue": "={{ $json.kanal }}",
                    "rightValue": "telegram",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "telegram"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "k_email",
                    "leftValue": "={{ $json.kanal }}",
                    "rightValue": "email",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "email"
            }
          ]
        },
        "looseTypeValidation": true,
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "unbekannt"
        }
      }
    },
    {
      "id": "sms_workflow_aufrufen",
      "name": "SMS-Workflow aufrufen",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        700,
        140
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "ID_SEND_SMS",
          "mode": "id",
          "cachedResultName": "ak-sub-send_sms"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "telegram_senden",
      "name": "Telegram senden",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "chatId": "={{ $json.ziel }}",
        "text": "={{ $json.meldung }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "9Vp8wPx7MROw0sAO",
          "name": "Telegram account"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "e_mail_senden",
      "name": "E-Mail senden",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        700,
        460
      ],
      "parameters": {
        "sendTo": "={{ $json.ziel }}",
        "subject": "=NOTFALL - {{ $json.config.kunde_name }} (Telefonagent)",
        "emailType": "text",
        "message": "={{ $json.meldung }}",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "rXdENEAJjoE47EcL",
          "name": "Gmail account Agent"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "antwort_bauen",
      "name": "Antwort bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "jsCode": "const ktx = $('Eingaben pruefen').first().json;\n// Vereinheitlicht die Antwort. Kein Sub-Workflow gibt je etwas anderes\n// zurueck als { success, data, message } - darauf bauen die Retell-Agenten\n// ihre Erfolgs- und Fehlerzweige auf.\nfunction antwort(success, data, message) {\n  return { success: !!success, data: data || {}, message: String(message || '') };\n}\n\nif (ktx.fehler) return [{ json: antwort(false, { alarmiert: false }, ktx.fehler) }];\n\nconst r = $input.first().json || {};\nif (r.error) {\n  return [{ json: antwort(false, { alarmiert: false }, 'bereitschaft nicht erreichbar') }];\n}\n// Der SMS-Weg liefert bereits das Standardschema zurueck und wird durchgereicht.\nif (typeof r.success === 'boolean') {\n  return [{ json: antwort(r.success, { alarmiert: r.success, kanal: ktx.kanal },\n    r.success ? 'bereitschaft alarmiert' : String(r.message || 'alarm fehlgeschlagen')) }];\n}\nreturn [{ json: antwort(true, { alarmiert: true, kanal: ktx.kanal }, 'bereitschaft alarmiert') }];"
      }
    },
    {
      "id": "notiz_9910",
      "name": "Notiz 9910",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        220,
        640
      ],
      "parameters": {
        "content": "## ak-sub-notify_dispatch\nKanal (`sms` | `telegram` | `email`) und Ziel kommen aus der Kunden-Config.\nDer SMS-Weg ruft `ak-sub-send_sms` auf - deshalb braucht der Kunde dann eine Vorlage namens `notfall`.",
        "width": 460,
        "height": 220,
        "color": 4
      }
    }
  ],
