          }
        ]
      ]
    },
    "Alarm-SMS senden": {
      "main": [
        [
          {
            "node": "Antwort bauen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram senden": {
      "main": [
        [
          {
            "node": "Antwort bauen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "E-Mail senden": {
      "main": [
        [
          {
